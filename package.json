{
  "name": "chainaudit-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:ps": "docker compose -f infra/docker-compose.yml ps",
    "mcp:dev": "node src/apps/mcp-server/main.ts",
    "seed:anvil": "node scripts/seed-anvil.ts",
    "issuer:dev": "node src/apps/token-issuer/main.ts",
    "hash-secret": "node scripts/hash-secret.ts",
    "gateway:dev": "node src/apps/gateway/main.ts",
    "verify": "bash scripts/verify.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "jose": "6.2.12",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "jose": "6.2.12"
    }
  }
}
